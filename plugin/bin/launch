#!/bin/sh
# Locus plugin launcher for the langgraph-workflow MCP server.
#
# Finds Python >= 3.10 (preferring the interpreter running Locus's agent
# server), builds a private virtual environment once under the plugin's data
# directory from hash-pinned wheels (requirements.lock) plus the vendored,
# checksummed langgraph-workflow wheel, then runs the server.
# stdout is the MCP channel: everything else goes to stderr.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
data=${LGW_DATA:-}
case "$data" in
  "" | '${'*) echo "langgraph-workflow: LGW_DATA is not set" >&2; exit 64 ;;
esac

usable() { "$1" -c 'import sys, venv; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; }

parent_python() {
  # The Locus agent server that started this process runs on Python 3.14.
  exe=$(readlink "/proc/$PPID/exe" 2>/dev/null || ps -o comm= -p "$PPID" 2>/dev/null || true)
  case "$exe" in */python*) echo "$exe" ;; esac
}

python=""
for candidate in "${LGW_PYTHON:-}" "$(parent_python)" python3.14 python3.13 python3.12 \
    python3.11 python3.10 /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
  [ -n "$candidate" ] || continue
  path=$(command -v "$candidate" 2>/dev/null) || continue
  if usable "$path"; then python=$path; break; fi
done
if [ -z "$python" ]; then
  echo "langgraph-workflow: needs Python 3.10 or newer (none found on PATH)" >&2
  exit 69
fi

tag=$("$python" -c 'import hashlib, sys
digest = hashlib.sha256()
for name in sys.argv[1:]:
    digest.update(open(name, "rb").read())
print(digest.hexdigest()[:12] + "-py%d%d" % sys.version_info[:2])' \
  "$root/requirements.lock" "$root/wheels/SHA256SUMS")
venv="$data/venv-$tag"

if [ ! -x "$venv/bin/python" ]; then
  echo "langgraph-workflow: first run; installing pinned dependencies with $python" >&2
  build="$data/.build-$$"
  rm -rf "$build"
  trap 'rm -rf "$build"' EXIT
  "$python" -m venv "$build" >&2
  "$build/bin/python" -m pip install --quiet --disable-pip-version-check \
    --require-hashes --only-binary=:all: -r "$root/requirements.lock" >&2
  "$build/bin/python" - "$root/wheels" >&2 <<'PY'
import hashlib, pathlib, subprocess, sys
wheels = pathlib.Path(sys.argv[1])
for line in (wheels / "SHA256SUMS").read_text().split("\n"):
    if not line.strip():
        continue
    expected, name = line.split()
    wheel = wheels / name
    if hashlib.sha256(wheel.read_bytes()).hexdigest() != expected:
        sys.exit(f"checksum mismatch for {name}")
    subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "--no-deps",
                    "--no-index", "--disable-pip-version-check", str(wheel)], check=True)
PY
  rm -rf "$venv"
  mv "$build" "$venv"
  trap - EXIT
fi

exec "$venv/bin/python" -m langgraph_workflow.mcp_server "$data"
