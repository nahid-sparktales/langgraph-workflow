+    def run_read_job(
+        self,
+        run_id: str,
+        job: AgentJob,
+        profile: AgentProfile,
+        budget: OrchestrationBudget,
+    ) -> AgentResult:
+        """Run one bounded, non-delegating read-only job.
+
+        This is the specialist path of a one-job wave, exposed for external
+        executors: the same scheduler lease, usage ledger, stop handling and
+        ``agent_job_*`` events. It offers no tools and never grants writes.
+        """
+        if job.execution_kind == "write":
+            raise OrchestrationError("run_read_job only runs read or check jobs")
+        return self._call_agent(run_id, job, profile, budget)
